---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import { url } from '../../lib/url';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

// Related project (only set if this is a project note)
let relatedProject = null;
if (note.data.type === 'project' && note.data.relatedProject) {
  relatedProject = await getEntry('projects', note.data.relatedProject);
}

// Related notes: the ones this note lists, plus the ones listing it back,
// so a new note never needs the old one edited to link both ways
const allNotes = await getCollection('notes');
const relatedIds = new Set(note.data.relatedNotes ?? []);
for (const n of allNotes) {
  if (n.data.relatedNotes?.includes(note.id)) relatedIds.add(n.id);
}
relatedIds.delete(note.id);
const relatedNotes = allNotes
  .filter((n) => relatedIds.has(n.id))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<BaseLayout title={note.data.title} description={note.data.summary} hue="notes">
  <div class="section docs-container">
    <div class="docs-layout">
      <aside class="docs-nav" data-pagefind-ignore>
        <NotesSidebar currentId={note.id} />
      </aside>

      <div class="docs-main">
        <a class="back-link" href={url('/notes')}>← 返回 Notes</a>
        <article class="article-body" data-pagefind-body>
        <header class="article-head">
          <div class="article-meta">
            <span>{formatDate(note.data.date)}</span>
            <span class="badge">{note.data.category}</span>
            {note.data.type === 'project' && <span>项目笔记</span>}
          </div>
          <h1 data-pagefind-meta="title">{note.data.title}</h1>
          <p class="muted">{note.data.summary}</p>

          {
            relatedProject && (
              <p class="related">
                关联项目:
                <a class="to-projects" href={url(`/projects/${relatedProject.id}`)}>
                  {relatedProject.data.title}
                </a>
              </p>
            )
          }

          <div class="tag-row">
            {note.data.tags.map((t) => (
              <a class="tag" href={`${url('/notes')}?tag=${encodeURIComponent(t)}`}>{t}</a>
            ))}
          </div>
        </header>

        <div class="markdown">
          <Content />
        </div>

        {
          relatedNotes.length > 0 && (
            <section class="related-notes" data-pagefind-ignore>
              <h2 class="rn-title">相关笔记</h2>
              <ul>
                {relatedNotes.map((n) => (
                  <li>
                    <a class="to-notes" href={url(`/notes/${n.id}`)}>{n.data.title}</a>
                    <span class="rn-date">{formatDate(n.data.date)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        </article>
      </div>

      <aside class="article-toc" data-pagefind-ignore>
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .related {
    font-size: 14px;
    margin: 0 0 16px;
  }

  .related-notes {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .rn-title {
    font-size: 18px;
    margin: 0 0 14px;
    color: var(--hue, var(--accent));
  }
  .related-notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .rn-date {
    margin-left: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  /* Three-column docs layout: left nav + body + right-side TOC */
  .docs-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .docs-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
  }
  .docs-main {
    min-width: 0;
    max-width: 760px;
  }
  .article-toc {
    position: relative;
  }
  /* Narrow screens: collapse the right-side TOC first, then the left nav */
  @media (max-width: 1100px) {
    .docs-layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .article-toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .docs-nav {
      display: none;
    }
  }
