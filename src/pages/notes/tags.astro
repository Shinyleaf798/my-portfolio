---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const notes = await getCollection('notes');

// 统计每个标签的出现次数
const counts = new Map<string, number>();
for (const n of notes) {
  for (const t of n.data.tags) counts.set(t, (counts.get(t) || 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// 按 category 分组, 便于快速浏览
const byCategory = new Map<string, Set<string>>();
for (const n of notes) {
  if (!byCategory.has(n.data.category)) byCategory.set(n.data.category, new Set());
  n.data.tags.forEach((t) => byCategory.get(n.data.category)!.add(t));
}
const categories = [...byCategory.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="标签总览" description="所有笔记标签的快速入口。">
  <div class="section container">
    <div class="page-header">
      <h1>标签总览</h1>
      <p>点击任意标签, 跳转到 Notes 列表并自动筛选该标签。</p>
    </div>

    <div class="cloud">
      {
        tags.map(([tag, count]) => (
          <a class="tag cloud-tag" href={`${url('/notes')}?tag=${encodeURIComponent(tag)}`}>
            {tag}<span class="count">{count}</span>
          </a>
        ))
      }
    </div>

    <div class="by-cat">
      {
        categories.map(([cat, catTags]) => (
          <div class="cat-block">
            <h2 class="cat-title">{cat}</h2>
            <div class="tag-row">
              {[...catTags].sort().map((t) => (
                <a class="tag" href={`${url('/notes')}?tag=${encodeURIComponent(t)}`}>
                  {t}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 52px;
  }
  .cloud-tag {
    font-size: 14px;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cloud-tag .count {
    font-size: 11px;
    color: var(--text-muted);
    background: var(--surface-3);
    border-radius: 20px;
    padding: 1px 7px;
  }
  .by-cat {
    display: grid;
    gap: 28px;
  }
  .cat-title {
    font-size: 15px;
    font-family: var(--font-mono);
    color: var(--accent);
    margin: 0 0 12px;
  }
</style>
