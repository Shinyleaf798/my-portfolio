---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { facetGroups } from '../../lib/tagGroups';

const notes = await getCollection('notes');

// Counted and sorted into the same groups the filter uses
const grouped = facetGroups(notes);

// Grouped by category for quick browsing
const byCategory = new Map<string, Set<string>>();
for (const n of notes) {
  if (!byCategory.has(n.data.category)) byCategory.set(n.data.category, new Set());
  n.data.tags.forEach((t) => byCategory.get(n.data.category)!.add(t));
}
const categories = [...byCategory.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="标签总览" description="所有笔记标签的快速入口。" hue="notes">
  <div class="section container">
    <div class="page-header">
      <h1>标签总览</h1>
      <p>点击任意标签, 跳转到 Notes 列表并自动筛选该标签。</p>
    </div>

    <div class="groups">
      {
        grouped.map((g) => (
          <div class="group">
            <h2 class="group-title">{g.label}</h2>
            <div class="cloud">
              {g.tags.map((t) => (
                <a
                  class="tag cloud-tag"
                  href={`${url('/notes')}?tag=${encodeURIComponent(t.tag)}`}
                >
                  {t.tag}<span class="count">{t.count}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="by-cat">
      {
        categories.map(([cat, catTags]) => (
          <div class="cat-block">
            <h2 class="cat-title">{cat}</h2>
            <div class="tag-row">
              {[...catTags].sort().map((t) => (
                <a class="tag" href={`${url('/notes')}?tag=${encodeURIComponent(t)}`}>
                  {t}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: 24px;
    margin-bottom: 52px;
  }
  .group-title {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--hue, var(--accent));
    margin: 0 0 10px;
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cloud-tag {
    font-size: 14px;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cloud-tag .count {
    font-size: 11px;
    color: var(--text-muted);
    background: var(--surface-3);
    border-radius: 20px;
    padding: 1px 7px;
  }
  .by-cat {
    display: grid;
    gap: 28px;
  }
  .cat-title {
    font-size: 15px;
    font-family: var(--font-mono);
    color: var(--accent);
    margin: 0 0 12px;
  }
</style>
