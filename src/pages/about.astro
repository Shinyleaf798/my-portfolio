---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="About" description="关于我 —— 一本公开的学习日记背后的人。" hue="projects">
  <div class="section container about">
    <article class="prose">
      <h1>关于我</h1>

      <p>
        嗨, 这里是我记录学习过程、整理项目和收集有用资料的地方。
      </p>

      <p>
        比起罗列 "我会用什么工具", 我更想把 "我是怎么踩坑、怎么解决问题的" 留下来 ——
        所以这站上每个项目后面都挂着当时写的笔记, 那才是能说明问题的部分。
      </p>

      <h2>这里有什么</h2>
      <div class="pills">
        <a class="pill hue-projects" href={url('/projects')}>
          <div class="pill-title">Projects</div>
          <div class="pill-value">折腾过的个人项目, 附开发时写的笔记</div>
        </a>
        <a class="pill hue-notes" href={url('/notes')}>
          <div class="pill-title">Notes</div>
          <div class="pill-value">学技术和语言时遇到的问题与解法</div>
        </a>
        <a class="pill hue-news" href={url('/news')}>
          <div class="pill-title">News</div>
          <div class="pill-value">看到的资讯, 加上自己的理解</div>
        </a>
      </div>

      <h2>找我</h2>
      <div class="pills">
        <a class="pill" href="https://github.com/Shinyleaf798">
          <div class="pill-title">GitHub</div>
          <div class="pill-value">github.com/Shinyleaf798</div>
        </a>
        <a class="pill" href="mailto:ngjiale086@gmail.com">
          <div class="pill-title">Email</div>
          <div class="pill-value">ngjiale086@gmail.com</div>
        </a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 720px;
  }
  .prose h1 {
    font-size: 32px;
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }
  .prose h2 {
    font-size: 20px;
    margin: 40px 0 16px;
  }
  .prose p {
    color: var(--text-primary);
    line-height: 1.8;
    margin: 0 0 18px;
  }
</style>
