---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { url } from '../lib/url';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout title="">
  <Hero />
  <Marquee />

  <section class="section container home-first" data-pagefind-ignore>
    <div class="section-title">
      <h2>精选项目</h2>
      <a href={url('/projects')}>查看全部 →</a>
    </div>
    {
      featured.length > 0 ? (
        <div class="card-grid">
          {featured.map((p) => (
            <ProjectCard
              id={p.id}
              title={p.data.title}
              date={p.data.date}
              summary={p.data.summary}
              tags={p.data.tags}
              featured={p.data.featured}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">还没有标记为 featured 的项目。</p>
      )
    }
  </section>

  <section class="section container" data-pagefind-ignore>
    <div class="section-title">
      <h2>最近更新</h2>
      <a href={url('/notes')}>全部笔记 →</a>
    </div>
    <div class="card-grid">
      {
        recentNotes.map((n) => (
          <NoteCard
            id={n.id}
            title={n.data.title}
            date={n.data.date}
            summary={n.data.summary}
            category={n.data.category}
            tags={n.data.tags}
            type={n.data.type}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* 首个区块紧跟倾斜标签带, 收窄顶部间距 */
  .home-first {
    padding-top: 48px;
  }
</style>
