---
import { url } from '../lib/url';
import { formatDate } from '../lib/format';
import { categoryColor } from '../lib/categoryColor';

interface Props {
  id: string;
  title: string;
  date: Date;
  summary: string;
  category: string;
  tags: string[];
  type: 'project' | 'general';
  // Title of the project this note belongs to, when it is a project note
  projectTitle?: string;
}

const { id, title, date, summary, category, tags, type, projectTitle } =
  Astro.props;

const d = formatDate(date);
const [year, monthDay] = [d.slice(0, 4), d.slice(5)];
---

{/* Rows view: one compact line — date, coloured dot, title, category.
    Cards view (inside [data-view='cards']) also shows summary and tags. */}
<a
  class="note"
  href={url(`/notes/${id}`)}
  data-tags={tags.join(',')}
  data-category={category}
  style={`--cat: ${categoryColor(category)}`}
>
  <span class="note-date" title={d}>{monthDay}<span class="note-year">{year}</span></span>
  <span class="note-main">
    <span class="note-title"><span class="cat-dot"></span><span>{title}</span></span>
    <span class="note-summary">{summary}</span>
    <span class="note-tags">
      {tags.filter((t) => t !== category).slice(0, 5).map((t) => <span class="tag" data-static>{t}</span>)}
      {projectTitle && <span class="note-project">关联 <span class="to-projects">{projectTitle}</span></span>}
    </span>
  </span>
  <span class="note-cat cat-label">
    {category}{type === 'project' && <span class="note-kind">· 项目</span>}
  </span>
</a>

<style>
  .note {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 13px 10px;
    margin: 0 -10px;
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: inherit;
    transition: background 0.18s ease;
  }
  .note:hover {
    background: var(--surface-2);
  }
  .note:hover .note-title {
    color: var(--hue, var(--accent));
  }
  .note-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .note-year {
    display: none;
  }
  .note-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--text-primary);
    transition: color 0.18s ease;
  }
  .note-title .cat-dot {
    transform: translateY(-1px);
  }
  .note-summary,
  .note-tags {
    display: none;
  }
  .note-kind {
    color: var(--text-muted);
  }
  .tag[data-static] {
    cursor: default;
  }

  /* ---- Cards view ---- */
  :global([data-view='cards']) .note {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  :global([data-view='cards']) .note:hover {
    border-color: var(--hue, var(--accent));
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
  }
  :global([data-view='cards']) .note-date {
    order: -1;
    font-size: 12px;
  }
  :global([data-view='cards']) .note-year {
    display: inline;
    margin-left: 6px;
    opacity: 0.7;
  }
  :global([data-view='cards']) .note-cat {
    order: -2;
  }
  :global([data-view='cards']) .note-title {
    font-size: 16.5px;
    font-weight: 600;
  }
  :global([data-view='cards']) .note-title .cat-dot {
    display: none;
  }
  :global([data-view='cards']) .note-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  :global([data-view='cards']) .note-summary {
    display: block;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  :global([data-view='cards']) .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .note {
      grid-template-columns: 52px minmax(0, 1fr);
    }
    .note-cat {
      display: none;
    }
    :global([data-view='cards']) .note-cat {
      display: inline-flex;
    }
  }
</style>
