---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  cover?: ImageMetadata;
  frame?: 'phone' | 'browser';
  // Shown on the placeholder when there is no cover yet
  stack?: string[];
  size?: 'large' | 'small';
}
const { title, cover, frame, stack = [], size = 'large' } = Astro.props;
const width = size === 'large' ? 960 : 520;
---

<div class:list={['pm', `pm-${size}`, frame && `pm-${frame}`]}>
  {
    cover ? (
      frame === 'browser' ? (
        <div class="pm-browser">
          <div class="pm-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <Image src={cover} alt={`${title} 截图`} width={width} class="pm-img" />
        </div>
      ) : frame === 'phone' ? (
        <div class="pm-phone">
          <Image src={cover} alt={`${title} 截图`} width={Math.round(width / 2.4)} class="pm-img" />
        </div>
      ) : (
        <Image src={cover} alt={`${title} 截图`} width={width} class="pm-img pm-fill" />
      )
    ) : (
      <div class="pm-empty" aria-hidden="true">
        <span class="pm-initial">{title.trim().charAt(0)}</span>
        {stack.length > 0 && <span class="pm-stack">{stack.slice(0, 3).join(' · ')}</span>}
      </div>
    )
  }
</div>

<style>
  .pm {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--surface-2);
    background-image: repeating-linear-gradient(
      135deg,
      var(--surface-2) 0 10px,
      transparent 10px 20px
    );
  }
  .pm-large {
    min-height: 360px;
    height: 100%;
  }
  .pm-small {
    height: 150px;
  }
  .pm-img {
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pm-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.pm-host:hover) .pm-img {
    transform: scale(1.03);
  }

  .pm-browser {
    width: 86%;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-deep);
    box-shadow: 0 20px 40px -24px var(--shadow);
  }
  .pm-browser .pm-img {
    width: 100%;
    height: auto;
  }
  .pm-bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
  }
  .pm-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }
  .pm-small .pm-browser {
    width: 80%;
    transform: translateY(18px);
  }

  .pm-phone {
    height: 86%;
    aspect-ratio: 9 / 19;
    border: 2px solid var(--border);
    border-radius: 26px;
    overflow: hidden;
    background: var(--bg-deep);
    box-shadow: 0 20px 40px -24px var(--shadow);
  }
  .pm-large .pm-phone {
    height: 320px;
  }
  .pm-phone .pm-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .pm-small .pm-phone {
    height: 200px;
    transform: translateY(40px);
  }

  .pm-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .pm-initial {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: var(--hue, var(--accent));
    opacity: 0.85;
  }
  .pm-small .pm-initial {
    font-size: 40px;
  }
  .pm-stack {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-img {
      transition: none;
    }
  }
</style>
