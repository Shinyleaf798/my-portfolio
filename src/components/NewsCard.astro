---
import { url } from '../lib/url';
import { formatDate } from '../lib/format';

interface Props {
  id: string;
  title: string;
  date: Date;
  summary: string;
  tags: string[];
}

const { id, title, date, summary, tags } = Astro.props;
---

<a class="card" href={url(`/news/${id}`)} data-tags={tags.join(',')}>
  <div class="meta">
    <span>{formatDate(date)}</span>
  </div>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  <div class="tag-row">
    {tags.map((t) => <span class="tag" data-static>{t}</span>)}
  </div>
</a>

<style>
  .card {
    color: inherit;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .tag[data-static] {
    cursor: default;
  }
</style>
