---
import { categoryColor } from '../lib/categoryColor';

interface Props {
  // Already grouped by lib/tagGroups.ts
  groups: { label: string; tags: { tag: string; count: number }[] }[];
  // Link at the bottom of the 技术 menu, e.g. the /notes/tags page
  allTagsUrl?: string;
}
const { groups, allTagsUrl } = Astro.props;

// One-row toolbar: the 领域 group stays visible as coloured chips; every
// other group folds into one of two menus. The groups themselves are
// unchanged, so the filter logic (OR inside a group, AND across groups)
// and ?tag= links keep working.
const CHIP_GROUP = '领域';
// Note kind (踩坑 / 概念 …): one per entry, so it works as single-choice tabs
const TYPE_GROUP = '类型';
const TECH_GROUPS = ['编程语言', '框架 & 库', '工具 & 平台'];

const chips = groups.find((g) => g.label === CHIP_GROUP);
const tabs = groups.find((g) => g.label === TYPE_GROUP);
const menus = [
  { id: 'tech', label: '技术', groups: groups.filter((g) => TECH_GROUPS.includes(g.label)) },
  {
    id: 'topic',
    label: '主题',
    groups: groups.filter(
      (g) => g.label !== CHIP_GROUP && g.label !== TYPE_GROUP && !TECH_GROUPS.includes(g.label)
    ),
  },
]
  .filter((m) => m.groups.length > 0)
  .map((m) => {
    const total = m.groups.reduce((n, g) => n + g.tags.length, 0);
    // Once a menu is long, tags used only once fold behind a toggle: they
    // narrow the list to one entry, which scrolling already does
    const foldRare = total >= 8;
    const rare = foldRare
      ? m.groups.reduce((n, g) => n + g.tags.filter((t) => t.count < 2).length, 0)
      : 0;
    return { ...m, total, foldRare, rare, searchable: total >= 8 };
  });
---

<div class="tag-filter" role="search" aria-label="按标签筛选">
  <div class:list={['tf-bar', { 'has-tabs': !!tabs }]}>
    {
      tabs && (
        <div class="tf-tabs" role="group" aria-label={TYPE_GROUP}>
          <button type="button" class="tf-tab" data-tf-all={TYPE_GROUP} aria-pressed="true">
            全部
          </button>
          {tabs.tags.map((t) => (
            <button
              type="button"
              class="tf-tab"
              data-filter={t.tag}
              data-group={TYPE_GROUP}
              data-single
              aria-pressed="false"
            >
              {t.tag}
              <span class="tf-count">{t.count}</span>
            </button>
          ))}
        </div>
      )
    }
    {
      chips && (
        <div class="tf-chips" role="group" aria-label={CHIP_GROUP}>
          {chips.tags.map((t) => (
            <button
              type="button"
              class="tf-chip"
              data-filter={t.tag}
              data-group={CHIP_GROUP}
              aria-pressed="false"
              style={`--cat: ${categoryColor(t.tag)}`}
            >
              <span class="cat-dot"></span>
              {t.tag}
              <span class="tf-count">{t.count}</span>
            </button>
          ))}
        </div>
      )
    }

    <div class="tf-end">
      {
        menus.map((m) => (
          <div class="tf-menu" data-tf-menu>
            <button
              type="button"
              class="tf-menu-btn"
              aria-expanded="false"
              aria-controls={`tf-panel-${m.id}`}
              data-tf-toggle
            >
              {m.label}
              <span class="tf-menu-n" data-tf-n></span>
              <span class="tf-caret" aria-hidden="true">▾</span>
            </button>
            <div class="tf-panel" id={`tf-panel-${m.id}`} hidden data-tf-panel>
              {m.searchable && (
                <label class="tf-search">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <circle cx="7" cy="7" r="5" />
                    <path d="M11 11l3.5 3.5" stroke-linecap="round" />
                  </svg>
                  <input type="search" placeholder={`搜索${m.label}`} data-tf-search aria-label={`搜索${m.label}`} />
                </label>
              )}
              <div class="tf-panel-body" data-tf-body>
                {m.groups.map((g) => (
                  <fieldset class="tf-group">
                    {m.groups.length > 1 && <legend>{g.label}</legend>}
                    {g.tags.map((t) => (
                      <label class:list={['tf-opt', { 'is-rare': m.foldRare && t.count < 2 }]} data-tf-opt={t.tag.toLowerCase()}>
                        <input type="checkbox" data-filter={t.tag} data-group={g.label} />
                        <span class="tf-opt-name">{t.tag}</span>
                        <span class="tf-count">{t.count}</span>
                      </label>
                    ))}
                  </fieldset>
                ))}
              </div>
              {m.rare > 0 && (
                <button type="button" class="tf-rare-toggle" data-tf-rare aria-expanded="false">
                  <span class="tf-rare-open">显示只出现 1 次的 {m.rare} 个</span>
                  <span class="tf-rare-close">收起</span>
                </button>
              )}
              {m.id === 'tech' && allTagsUrl && (
                <a class="tf-all" href={allTagsUrl}>查看全部标签 →</a>
              )}
            </div>
          </div>
        ))
      }
      <slot name="end" />
    </div>
  </div>

  <div class="tf-active" data-tf-active hidden>
    <span class="tf-active-label">已选</span>
    <span class="tf-active-list" data-tf-active-list></span>
    <button type="button" class="tf-clear" data-tf-clear>清除全部</button>
  </div>
</div>
<p class="tf-empty" data-tf-empty hidden>
  没有同时满足这些标签的内容。去掉几个再试。
</p>

<style>
  .tag-filter {
    margin: -12px 0 28px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .tf-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  /* With type tabs, they lead the top line and the domain chips drop to
     their own line underneath */
  .tf-bar.has-tabs .tf-chips {
    order: 2;
    flex-basis: 100%;
  }
  .tf-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tf-tab {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-muted);
    font: 600 14.5px var(--font-sans);
    line-height: 34px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .tf-tab:hover {
    color: var(--text-primary);
  }
  .tf-tab[aria-pressed='true'] {
    color: var(--hue, var(--accent));
    border-bottom-color: var(--hue, var(--accent));
  }
  .tf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .tf-end {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .tf-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: none;
    color: var(--text-primary);
    font: 500 13.5px var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .tf-chip:hover {
    border-color: var(--cat);
  }
  .tf-chip[aria-pressed='true'] {
    border-color: var(--cat);
    background: color-mix(in srgb, var(--cat) 16%, transparent);
  }
  .tf-count {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .tf-menu {
    position: relative;
  }
  .tf-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: none;
    color: var(--text-primary);
    font: 500 13.5px var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .tf-menu-btn:hover,
  .tf-menu-btn[aria-expanded='true'],
  .tf-menu-btn.has-picks {
    border-color: var(--hue, var(--accent));
    color: var(--hue, var(--accent));
  }
  .tf-menu-btn.has-picks {
    background: color-mix(in srgb, var(--hue, var(--accent)) 10%, transparent);
  }
  .tf-caret {
    font-size: 10px;
    opacity: 0.7;
  }

  .tf-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
    width: 300px;
    max-height: min(460px, 70vh);
    overflow-y: auto;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--menu-bg);
    backdrop-filter: blur(8px);
    box-shadow: 0 20px 40px -16px var(--shadow);
  }
  .tf-panel[hidden] {
    display: none;
  }
  .tf-search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    margin-bottom: 4px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
  }
  .tf-search svg {
    width: 13px;
    height: 13px;
    flex: none;
  }
  .tf-search input {
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font: 13px var(--font-sans);
  }
  .tf-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .tf-group legend {
    padding: 12px 6px 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .tf-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 0 6px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    color: var(--text-primary);
    cursor: pointer;
  }
  .tf-opt:hover {
    background: var(--surface-3);
  }
  .tf-opt input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--hue, var(--accent));
  }
  .tf-opt-name {
    flex: 1;
  }
  /* Rare tags hide until asked for — but never a checked one, and never
     while searching */
  .tf-opt.is-rare {
    display: none;
  }
  .tf-panel.show-rare .tf-opt.is-rare,
  .tf-panel.searching .tf-opt.is-rare,
  .tf-opt.is-rare:has(input:checked) {
    display: flex;
  }
  .tf-opt.no-match,
  .tf-panel .tf-opt.is-rare.no-match {
    display: none;
  }
  .tf-group:not(:has(.tf-opt:not(.no-match):not(.is-rare))) legend {
    display: none;
  }
  .tf-panel.show-rare .tf-group legend,
  .tf-panel.searching .tf-group:has(.tf-opt:not(.no-match)) legend {
    display: block;
  }
  .tf-rare-toggle {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 8px 6px;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: 12.5px var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .tf-rare-toggle:hover {
    color: var(--text-primary);
  }
  .tf-rare-close,
  .tf-panel.show-rare .tf-rare-open {
    display: none;
  }
  .tf-panel.show-rare .tf-rare-close {
    display: inline;
  }
  .tf-all {
    display: block;
    margin-top: 8px;
    padding: 10px 6px 2px;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }

  .tf-active {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .tf-active[hidden] {
    display: none;
  }
  .tf-active-label {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .tf-active-list {
    display: contents;
  }
  .tf-active :global(.tf-pick) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid color-mix(in srgb, var(--hue, var(--accent)) 45%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--hue, var(--accent)) 12%, transparent);
    color: var(--hue, var(--accent));
    font: 500 12.5px var(--font-sans);
    cursor: pointer;
  }
  .tf-active :global(.tf-pick:hover) {
    border-color: var(--hue, var(--accent));
  }
  .tf-clear {
    margin-left: auto;
    padding: 4px 6px;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: 12.5px var(--font-sans);
    cursor: pointer;
  }
  .tf-clear:hover {
    color: var(--hue, var(--accent));
  }
  .tf-empty {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 28px;
  }
  .tf-empty[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .tf-end {
      margin-left: 0;
      width: 100%;
    }
    .tf-panel {
      right: auto;
      left: 0;
      width: min(300px, calc(100vw - 32px));
    }
    .tf-menu:last-of-type .tf-panel {
      left: auto;
      right: 0;
    }
  }
</style>

<script>
  // Multi-select tag filtering, no page navigation.
  //
  // Selection rules, the standard faceted-search ones:
  //   within one group  -> OR   (领域: 前端 + 后端 = either)
  //   across groups     -> AND  (领域:前端 AND 编程语言:TypeScript)
  //
  // Preselection via ?tag=a,b in the URL, for links from /notes/tags.
  function initScope(scope: HTMLElement) {
    const filter = scope.querySelector<HTMLElement>('.tag-filter');
    if (!filter) return;

    const chips = Array.from(filter.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const boxes = Array.from(filter.querySelectorAll<HTMLInputElement>('input[data-filter]'));
    const menus = Array.from(filter.querySelectorAll<HTMLElement>('[data-tf-menu]'));
    const activeRow = filter.querySelector<HTMLElement>('[data-tf-active]');
    const activeList = filter.querySelector<HTMLElement>('[data-tf-active-list]');
    const clearBtn = filter.querySelector<HTMLButtonElement>('[data-tf-clear]');
    const emptyEl = scope.querySelector<HTMLElement>('[data-tf-empty]');
    const countEl = scope.querySelector<HTMLElement>('[data-result-count]');
    const cards = Array.from(scope.querySelectorAll<HTMLElement>('[data-tags]')).filter(
      (el) => !filter.contains(el)
    );

    const groupOf = new Map<string, string>();
    [...chips, ...boxes].forEach((el) => groupOf.set(el.dataset.filter || '', el.dataset.group || ''));

    // Selection order is kept, so the 已选 row reads in the order clicked
    const active = new Set<string>();

    function apply() {
      const picked = new Map<string, string[]>();
      for (const tag of active) {
        const g = groupOf.get(tag) || '';
        if (!picked.has(g)) picked.set(g, []);
        picked.get(g)!.push(tag);
      }

      let shown = 0;
      for (const card of cards) {
        const cardTags = (card.dataset.tags || '').split(',').map((s) => s.trim());
        let match = true;
        for (const tags of picked.values()) {
          if (!tags.some((t) => cardTags.includes(t))) {
            match = false;
            break;
          }
        }
        card.style.display = match ? '' : 'none';
        if (match) shown++;
      }

      chips.forEach((c) => c.setAttribute('aria-pressed', String(active.has(c.dataset.filter || ''))));
      allBtns.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          String(![...active].some((t) => groupOf.get(t) === b.dataset.tfAll))
        )
      );
      boxes.forEach((b) => (b.checked = active.has(b.dataset.filter || '')));
      menus.forEach((m) => {
        const n = Array.from(m.querySelectorAll<HTMLInputElement>('input[data-filter]')).filter(
          (b) => b.checked
        ).length;
        m.querySelector('[data-tf-toggle]')?.classList.toggle('has-picks', n > 0);
        const badge = m.querySelector<HTMLElement>('[data-tf-n]');
        if (badge) badge.textContent = n > 0 ? `· ${n}` : '';
      });

      if (activeList) {
        activeList.replaceChildren(
          ...[...active].map((tag) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'tf-pick';
            b.textContent = `${tag} ✕`;
            b.setAttribute('aria-label', `移除 ${tag}`);
            b.addEventListener('click', () => {
              active.delete(tag);
              select();
            });
            return b;
          })
        );
      }
      if (activeRow) activeRow.hidden = active.size === 0;
      if (countEl) countEl.textContent = String(shown);
      if (emptyEl) emptyEl.hidden = shown > 0;

      // Lets a listing regroup itself (month counts, folded sections)
      scope.dispatchEvent(new CustomEvent('tagfilter', { detail: { active: active.size, shown } }));
    }

    function select() {
      apply();
      const u = new URL(window.location.href);
      if (active.size === 0) u.searchParams.delete('tag');
      else u.searchParams.set('tag', [...active].join(','));
      history.replaceState(null, '', u);
    }

    const singles = new Set(
      chips.filter((c) => c.hasAttribute('data-single')).map((c) => c.dataset.group || '')
    );
    const allBtns = Array.from(filter.querySelectorAll<HTMLButtonElement>('[data-tf-all]'));

    const flip = (tag: string, on: boolean) => {
      const g = groupOf.get(tag) || '';
      // Single-choice groups (type tabs): picking one replaces the other
      if (on && singles.has(g)) {
        for (const t of [...active]) if (groupOf.get(t) === g) active.delete(t);
      }
      if (on) active.add(tag);
      else active.delete(tag);
      select();
    };
    allBtns.forEach((b) =>
      b.addEventListener('click', () => {
        for (const t of [...active]) if (groupOf.get(t) === b.dataset.tfAll) active.delete(t);
        select();
      })
    );
    chips.forEach((c) =>
      c.addEventListener('click', () => flip(c.dataset.filter || '', !active.has(c.dataset.filter || '')))
    );
    boxes.forEach((b) => b.addEventListener('change', () => flip(b.dataset.filter || '', b.checked)));
    clearBtn?.addEventListener('click', () => {
      active.clear();
      select();
    });

    // Menus: one open at a time; outside click or Escape closes
    const close = (m: HTMLElement, focus = false) => {
      const btn = m.querySelector<HTMLButtonElement>('[data-tf-toggle]');
      const panel = m.querySelector<HTMLElement>('[data-tf-panel]');
      if (!btn || !panel || panel.hidden) return;
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      if (focus) btn.focus();
    };
    menus.forEach((m) => {
      const btn = m.querySelector<HTMLButtonElement>('[data-tf-toggle]')!;
      const panel = m.querySelector<HTMLElement>('[data-tf-panel]')!;
      const search = m.querySelector<HTMLInputElement>('[data-tf-search]');
      const opts = Array.from(m.querySelectorAll<HTMLElement>('[data-tf-opt]'));

      btn.addEventListener('click', () => {
        const opening = panel.hidden;
        menus.forEach((o) => close(o));
        if (opening) {
          panel.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          search?.focus();
        }
      });
      m.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close(m, true);
      });
      m.querySelector('[data-tf-rare]')?.addEventListener('click', (e) => {
        const on = panel.classList.toggle('show-rare');
        (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(on));
      });
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        panel.classList.toggle('searching', q.length > 0);
        opts.forEach((o) => o.classList.toggle('no-match', q.length > 0 && !o.dataset.tfOpt!.includes(q)));
      });
    });
    document.addEventListener('click', (e) => {
      menus.forEach((m) => {
        if (!m.contains(e.target as Node)) close(m);
      });
    });

    // Initial state: read ?tag=a,b from the URL
    const preset = (new URL(window.location.href).searchParams.get('tag') || '')
      .split(',')
      .map((t) => t.trim())
      .filter((t) => groupOf.has(t));
    preset.forEach((t) => active.add(t));
    apply();
  }

  document.querySelectorAll<HTMLElement>('[data-filter-scope]').forEach(initScope);
</script>
