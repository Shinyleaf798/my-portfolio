---
import { getCollection } from 'astro:content';

// Topics for the scrolling marquee: pulled from real note categories and tags
const notes = await getCollection('notes');
const topicSet = new Set<string>();
for (const n of notes) {
  topicSet.add(n.data.category);
  n.data.tags.forEach((t) => topicSet.add(t));
}
let topics = [...topicSet];
if (topics.length === 0) {
  topics = ['Python', 'Rust', '日语', '前端', 'Astro', '学习笔记'];
}
---

<div class="marquee-wrap" aria-hidden="true">
  <div class="marquee-band">
    <div class="marquee-track">
      {[...topics, ...topics].map((t) => (
        <span class="marquee-item">
          <span class="spark">✦</span>{t}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  /* overflow-x: clip only trims horizontal overflow (prevents a horizontal
     scrollbar) and leaves the vertical axis untrimmed, so the corners that
     poke out from the rotation stay fully visible.
     The vertical margin gives the tilted corners room without overlapping
     neighboring content. */
  .marquee-wrap {
    overflow-x: clip;
    margin: 10px 0;
  }
  .marquee-band {
    position: relative;
    /* Slightly wider than the viewport and shifted left, so no gap shows
       at either end once rotated */
    width: 104%;
    margin-left: -2%;
    min-height: 62px;
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, #0d1117, #10261f 50%, #0d1117);
    border-top: 1px solid var(--accent-dim);
    border-bottom: 1px solid var(--accent-dim);
    transform: rotate(-1.6deg);
    overflow: hidden; /* clips the scrolling text to inside the band */
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    line-height: 1;
    animation: marquee 32s linear infinite;
  }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 0 22px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: #e6edf3;
    white-space: nowrap;
  }
  .marquee-item .spark {
    color: #2dd4bf;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
