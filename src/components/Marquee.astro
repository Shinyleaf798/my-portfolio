---
import { getCollection } from 'astro:content';

interface Props {
  /** Scroll speed in pixels per second. Higher = faster. */
  speed?: number;
}
const { speed = 60 } = Astro.props;

// Topics for the scrolling marquee: pulled from real note categories and tags
const notes = await getCollection('notes');
const topicSet = new Set<string>();
for (const n of notes) {
  topicSet.add(n.data.category);
  n.data.tags.forEach((t) => topicSet.add(t));
}
let topics = [...topicSet];
if (topics.length === 0) {
  topics = ['Python', 'Rust', '日语', '前端', 'Astro', '学习笔记'];
}

// Rough width of one item in px, used to repeat the list until it is long
// enough to fill a wide screen. Keeps the loop seamless even without JS.
const estimateWidth = (text: string) => {
  let w = 44 + 15 + 22; // padding + spark + gap
  for (const ch of text) w += /[　-鿿＀-￯]/.test(ch) ? 15 : 9;
  return w;
};
const setWidth = topics.reduce((sum, t) => sum + estimateWidth(t), 0);
const repeat = Math.max(1, Math.ceil(2000 / Math.max(setWidth, 1)));
const items = Array.from({ length: repeat }, () => topics).flat();
---

<div class="marquee-wrap" aria-hidden="true">
  <div class="marquee-band">
    <div class="marquee-track" data-speed={speed}>
      <div class="marquee-group">
        {items.map((t) => (
          <span class="marquee-item">
            <span class="spark">✦</span>{t}
          </span>
        ))}
      </div>
      <div class="marquee-group">
        {items.map((t) => (
          <span class="marquee-item">
            <span class="spark">✦</span>{t}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* overflow-x: clip only trims horizontal overflow (prevents a horizontal
     scrollbar) and leaves the vertical axis untrimmed, so the corners that
     poke out from the rotation stay fully visible.
     The vertical margin gives the tilted corners room without overlapping
     neighboring content. */
  .marquee-wrap {
    overflow-x: clip;
    margin: 10px 0;
  }
  .marquee-band {
    position: relative;
    /* Slightly wider than the viewport and shifted left, so no gap shows
       at either end once rotated */
    width: 104%;
    margin-left: -2%;
    min-height: 62px;
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, #0d1117, #10261f 50%, #0d1117);
    border-top: 1px solid var(--accent-dim);
    border-bottom: 1px solid var(--accent-dim);
    transform: rotate(-1.6deg);
    overflow: hidden; /* clips the scrolling text to inside the band */
  }
  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    line-height: 1;
    /* --shift is the width of one group; the script measures it.
       Fallback 50% works when the track is exactly two groups. */
    animation: marquee var(--marquee-duration, 32s) linear infinite;
  }
  .marquee-group {
    display: flex;
    align-items: center;
    flex: none;
  }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 0 22px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: #e6edf3;
    white-space: nowrap;
  }
  .marquee-item .spark {
    color: #2dd4bf;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--shift, 50%)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  // Clone groups until the track is wider than the band, then derive the
  // animation duration from a constant pixel-per-second speed.
  const setup = (track: HTMLElement) => {
    const band = track.parentElement as HTMLElement;
    const first = track.firstElementChild as HTMLElement;
    if (!first) return;

    // Drop extra clones from a previous run, keep the two original groups.
    while (track.children.length > 2) track.lastElementChild!.remove();

    const groupWidth = first.getBoundingClientRect().width;
    if (groupWidth === 0) return;

    // Need at least one group beyond what the band shows at once.
    const needed = Math.max(2, Math.ceil(band.offsetWidth / groupWidth) + 1);
    while (track.children.length < needed) {
      track.appendChild(first.cloneNode(true));
    }

    const speed = Number(track.dataset.speed) || 60;
    track.style.setProperty('--shift', `${groupWidth}px`);
    track.style.setProperty('--marquee-duration', `${groupWidth / speed}s`);
  };

  const init = () => {
    document.querySelectorAll<HTMLElement>('.marquee-track').forEach(setup);
  };

  init();
  if (document.fonts) document.fonts.ready.then(init);
  let t: number;
  window.addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(init, 200);
  });
</script>
