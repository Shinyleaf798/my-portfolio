---
import { url } from '../lib/url';
import { formatDate } from '../lib/format';

interface Props {
  id: string;
  title: string;
  date: Date;
  summary: string;
  category: string;
  tags: string[];
  type: 'project' | 'general';
}

const { id, title, date, summary, category, tags, type } = Astro.props;
---

<a class="card" href={url(`/notes/${id}`)} data-tags={tags.join(',')} data-category={category}>
  <div class="meta">
    <span>{formatDate(date)}</span>
    <span class="badge">{category}</span>
    {type === 'project' && <span class="mono muted">· 项目笔记</span>}
  </div>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  <div class="tag-row">
    {tags.map((t) => <span class="tag" data-static>{t}</span>)}
  </div>
</a>

<style>
  .card {
    color: inherit;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .tag[data-static] {
    cursor: default;
  }
</style>
